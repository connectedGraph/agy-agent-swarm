# systemd user 单元模板，由 install.sh 渲染后安装。
#   @APP_ROOT@  仓库绝对路径（install.sh 所在目录）
#   @NODE_BIN@  当前 node 可执行文件
#   @NODE_DIR@  node 所在目录（进 PATH）
# %h 是 systemd 的用户主目录占位符，换用户不用改文件。
[Unit]
Description=agy-agent-swarm 控制台 (127.0.0.1:3100)
Documentation=file://@APP_ROOT@/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@APP_ROOT@
Environment=PORT=3100
Environment=HOSTNAME=127.0.0.1
# standalone 的 server.js 会 chdir 到部署目录，仓库内文件与数据目录一律用绝对路径
Environment=SWARM_APP_ROOT=@APP_ROOT@
Environment=SWARM_TASKS_DIR=@APP_ROOT@/data/tasks
Environment=SWARM_ROOT=@APP_ROOT@/data/runs
Environment=AGY_BIN=%h/.local/bin/agy
Environment=BWRAP_BIN=/usr/bin/bwrap
Environment=HOME=%h
Environment=PATH=@NODE_DIR@:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=@NODE_BIN@ @APP_ROOT@/dist/standalone/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=mixed

# 故意不做 ProtectHome/ProtectSystem 沙箱：
# 编排器要读取用户的 base 仓库、在 data/ 下建 worktree，并 spawn bwrap + agy，
# 沙箱化 systemd 单元会让这些路径不可见。隔离由执行侧的 bubblewrap 负责。

[Install]
WantedBy=default.target
